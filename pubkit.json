{
  "kind": "utility",
  "ci": {
    "language": "python",
    "with": {
      "setup": "python -m venv .venv && .venv/bin/pip install --quiet --require-hashes -r tests/requirements.lock && .venv/bin/pip install --quiet -r requirements.lock",
      "test": ".venv/bin/python -m pytest -q tests",
      "sonar-args": "-Dsonar.sources=review_tooling,review-site/review"
    },
    "release": {}
  },
  "protect": {
    "checks": [
      "ci / passed",
      "integrations / scan"
    ],
    "tags": false
  },
  "signing_keys": [
    {"path": "corpus/.publet/signing.key", "bitwarden": {"project": {"id": "377de170-5487-40f7-9a01-b4f50064e1c5", "name": "Pub"}, "name": "pub-signing-key-review-tooling"}}
  ],
  "mirror": {
    "wheels": "https://storage.sustenaut.eu/wheels",
    "terraform": "https://storage.sustenaut.eu/terraform",
    "pypi": "https://storage.sustenaut.eu/pypi"
  }
}
